# Server-side only. Set through your host or load an owner-only credential file.
NTK_PROVIDER=bedrock
NTK_MODEL=openai.gpt-oss-120b-1:0
NTK_EXPERIMENT=gpt-oss120b-routing-v21-20261105
NTK_PROMPT_VERSION=inr-assistant/2.1.0
NTK_DATASET_FILE=data/cases-v2.json
NTK_BEDROCK_MAX_TOKENS=4096
NTK_BEDROCK_REASONING_EFFORT=low
NTK_AWS_REGION=us-east-1
# Uses the standard AWS credential chain. A profile is optional; roles work too.
NTK_AWS_PROFILE=
NTK_ENABLE_BEDROCK_FRESH=false
NTK_BEDROCK_CALL_LIMIT=100
NTK_RUNTIME_DIR=runtime
NTK_ALLOWED_HOSTS=localhost,127.0.0.1

# Original local experiment: unset NTK_EXPERIMENT and set NTK_PROVIDER=ollama,
# NTK_MODEL=qwen2.5:3b and NTK_OLLAMA_URL=http://127.0.0.1:11434; also unset
# NTK_PROMPT_VERSION, NTK_DATASET_FILE and NTK_BEDROCK_REASONING_EFFORT.

# Optional cloud mode: NTK_PROVIDER=openai; NTK_MODEL=gpt-4.1-mini-2025-04-14
NTK_OPENAI_API_KEY=
NTK_MODEL_ENV_FILE=

# Optional live PayPal sandbox connection. Never use production credentials.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
NTK_PAYPAL_ENV_FILE=
NTK_PAYPAL_ORDER_ID=
NTK_PAYPAL_CAPTURE_ID=
NTK_PAYPAL_DISPUTE_ID=
NTK_COMPLETION_RECORD=
